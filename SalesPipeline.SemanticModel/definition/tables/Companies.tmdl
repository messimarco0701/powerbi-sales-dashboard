		sourceColumn: Segment order

		annotation SummarizationSetBy = User

	partition Companies = m
		mode: import
		source =
				let
				    // DataFolder can be a local folder or the raw GitHub URL of this repo's data folder
				    Content = if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "dim_company.csv") else File.Contents(DataFolder & "dim_company.csv"),
				    Source = Csv.Document(Content, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty strings in the CSV mean "no value", not an empty text
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Renamed = Table.RenameColumns(Nulls, {{"company_id", "Company ID"}, {"company_name", "Company name"}, {"sector", "Sector"}, {"region", "Region"}, {"employees", "Employees"}, {"size_segment", "Size segment"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Company ID", Int64.Type}, {"Company name", type text}, {"Sector", type text}, {"Region", type text}, {"Employees", Int64.Type}, {"Size segment", type text}}, "en-US"),
				    Order = Table.AddColumn(Typed, "Segment order", each List.PositionOf({"Micro", "Small", "Medium", "Large"}, [Size segment]) + 1, Int64.Type)
				in
				    Order

	annotation PBI_ResultType = Table
