	partition Partners = m
		mode: import
		source =
				let
				    // DataFolder can be a local folder or the raw GitHub URL of this repo's data folder
				    Content = if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "dim_partner.csv") else File.Contents(DataFolder & "dim_partner.csv"),
				    Source = Csv.Document(Content, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty strings in the CSV mean "no value", not an empty text
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Renamed = Table.RenameColumns(Nulls, {{"partner_id", "Partner ID"}, {"partner_name", "Partner name"}, {"partner_type", "Partner type"}, {"region", "Partner region"}, {"onboarded_date", "Onboarded date"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Partner ID", Int64.Type}, {"Partner name", type text}, {"Partner type", type text}, {"Partner region", type text}, {"Onboarded date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
