	column 'Days in current stage'
		dataType: int64
		formatString: 0
		lineageTag: a3361c7e-c6ae-4eea-a567-436640f6d8fc
		summarizeBy: none
		sourceColumn: Days in current stage

		annotation SummarizationSetBy = User

	partition Deals = m
		mode: import
		source =
				let
				    // DataFolder can be a local folder or the raw GitHub URL of this repo's data folder
				    Content = if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "fact_deals.csv") else File.Contents(DataFolder & "fact_deals.csv"),
				    Source = Csv.Document(Content, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty strings in the CSV mean "no value", not an empty text
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Renamed = Table.RenameColumns(Nulls, {{"deal_id", "Deal ID"}, {"deal_name", "Deal name"}, {"company_id", "Company ID"}, {"owner_id", "Owner ID"}, {"partner_id", "Partner ID"}, {"channel", "Channel"}, {"deal_type", "Deal type"}, {"product", "Product"}, {"created_date", "Created date"}, {"close_date", "Close date"}, {"stage", "Stage"}, {"last_open_stage", "Last open stage"}, {"is_closed", "Is closed"}, {"is_won", "Is won"}, {"lost_reason", "Lost reason"}, {"employees_covered", "Employees covered"}, {"amount", "Amount"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Deal ID", Int64.Type}, {"Deal name", type text}, {"Company ID", Int64.Type}, {"Owner ID", Int64.Type}, {"Partner ID", Int64.Type}, {"Channel", type text}, {"Deal type", type text}, {"Product", type text}, {"Created date", type date}, {"Close date", type date}, {"Stage", type text}, {"Last open stage", type text}, {"Is closed", type logical}, {"Is won", type logical}, {"Lost reason", type text}, {"Employees covered", Int64.Type}, {"Amount", type number}}, "en-US"),
				    Status = Table.AddColumn(Typed, "Status", each if [Is won] then "Won" else if [Is closed] then "Lost" else "Open", type text),
				    StatusOrder = Table.AddColumn(Status, "Status order", each List.PositionOf({"Open", "Won", "Lost"}, [Status]) + 1, Int64.Type),
				    StageOrder = Table.AddColumn(StatusOrder, "Last open stage order", each List.PositionOf({"Discovery", "Qualified", "Proposal", "Negotiation", "Closed Won", "Closed Lost"}, [Last open stage]) + 1, Int64.Type),
				    Cycle = Table.AddColumn(StageOrder, "Cycle days", each if [Close date] = null then null else Duration.Days([Close date] - [Created date]), Int64.Type),
				    Age = Table.AddColumn(Cycle, "Age days", each if [Is closed] then null else Duration.Days(SnapshotDate - [Created date]), Int64.Type),
				    // when did the open deal enter the stage it is sitting in: its most recent history row
				    Entered = Table.Group(StageHistory, {"Deal ID"}, {{"Stage entered", each List.Max([Entered date]), type date}}),
				    Joined = Table.NestedJoin(Age, {"Deal ID"}, Entered, {"Deal ID"}, "E", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "E", {"Stage entered"}),
				    InStage = Table.AddColumn(Expanded, "Days in current stage", each if [Is closed] or [Stage entered] = null then null else Duration.Days(SnapshotDate - [Stage entered]), Int64.Type),
				    Result = Table.RemoveColumns(InStage, {"Stage entered"})
				in
				    Result

	annotation PBI_ResultType = Table
