model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "SnapshotDate", "Deals", "StageHistory", "Companies", "Partners", "Owners", "Targets", "Channels", "Date"]

ref table Deals
ref table StageHistory
ref table Companies
ref table Partners
ref table Owners
ref table Targets
ref table Channels
ref table 'Date'
